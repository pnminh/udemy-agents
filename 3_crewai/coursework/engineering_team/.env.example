# LLM provider: gemini (Vertex ADC) or deepseek (API key)
COURSEWORK_LLM_PROVIDER=deepseek

# --- Gemini on Vertex AI (ADC) — no API key required ---
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini/gemini-3.1-pro-preview

# --- DeepSeek API (when COURSEWORK_LLM_PROVIDER=deepseek) ---
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
# Optional custom endpoint:
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional: CrewAI tracing dashboard
# CREWAI_API_KEY=your-crewai-api-key
