# LLM provider: gemini (Vertex ADC) or deepseek (API key)
COURSEWORK_LLM_PROVIDER=gemini

# --- Gemini on Vertex AI (ADC) — no API key required ---
# Authenticate once: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini/gemini-3.1-pro-preview

# Do NOT set GOOGLE_API_KEY or GEMINI_API_KEY when using Vertex ADC.

# --- DeepSeek API (when COURSEWORK_LLM_PROVIDER=deepseek) ---
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
# Optional custom endpoint:
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# SMTP settings are read from the repo-root agents2/.env:
# SMTP_SERVER_URL, SMTP_SERVER_PORT, SMTP_SERVER_USERNAME,
# SMTP_SERVER_EMAIL, SMTP_SERVER_PASSWORD
#
# Optional app-local overrides:
# SERPER_API_KEY=your-serper-api-key
